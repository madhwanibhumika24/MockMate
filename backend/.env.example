# Gemini API key for interview question/feedback generation --
# ai.google.dev -> "Get API key". Free tier is enough for gemini-3.5-flash-lite.
# NOT the same as GOOGLE_CLIENT_ID/SECRET below, which are for "Sign in with
# Google" and come from a different place (Google Cloud Console).
GOOGLE_API_KEY=

# No longer used (switched to Gemini above) -- left only in case the RAG
# pipeline (deferred, see requirements.txt) is ever resumed with OpenAI
# embeddings specifically.
OPENAI_API_KEY=

# MySQL, using the PyMySQL driver (pure Python, no extra build tools needed).
# Create the database first (see backend README/setup notes), then fill in
# your real host/user/password/db name here in your own .env -- never commit
# the filled-in file.
DATABASE_URL=mysql+pymysql://mockmate_app:14300827@localhost:3306/mockmate

VECTOR_STORE_BACKEND=chroma
VECTOR_STORE_PATH=./data/vector_store
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development

# --- Auth ---------------------------------------------------------------
# Random secret used to sign login session tokens. Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Never reuse this value across projects, and never commit the real one.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# How long a password-reset code stays valid for, in minutes.
RESET_CODE_EXPIRE_MINUTES=5

FRONTEND_URL=http://localhost:5173

# --- Email (Gmail SMTP) --------------------------------------------------
# SMTP_USERNAME is your full Gmail address. SMTP_PASSWORD is NOT your normal
# Gmail password -- it's a 16-character "App Password":
#   1. myaccount.google.com/security -> turn on 2-Step Verification
#   2. myaccount.google.com/apppasswords -> create one named e.g. "MockMate"
#   3. paste the 16-character code below (spaces don't matter)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MockMate

# --- Google OAuth ---------------------------------------------------------
# console.cloud.google.com -> create a project -> "APIs & Services" ->
# "OAuth consent screen" (External) -> "Credentials" -> "Create Credentials"
# -> "OAuth client ID" (Web application). Add the redirect URI below to the
# app's Authorized redirect URIs, then copy the client ID/secret it gives you.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- GitHub OAuth ----------------------------------------------------------
# github.com/settings/developers -> "OAuth Apps" -> "New OAuth App".
# Homepage URL: http://localhost:5173
# Authorization callback URL: the redirect URI below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
